MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/jct_admin
NEXTAUTH_SECRET=your-random-32-char-secret-here
NEXTAUTH_URL=http://localhost:3000

# On-prem compose deploys only. `next build` prerenders the DB-backed public
# pages, and docker-compose.prod.yaml gives that build `network: host` so it can
# reach a MongoDB published on loopback. In the host network namespace the
# compose service alias `mongo` does not resolve, so MONGODB_URI as written
# above is unusable at build time — the build then silently falls back to empty
# pages that stay wrong until the next revalidation. This is the same
# connection reached the way the *host* sees it; it is passed as a BuildKit
# secret and never lands in an image layer. Ignore it on Atlas or anywhere the
# runtime URI already works from the host.
MONGODB_BUILD_URI=mongodb://username:password@127.0.0.1:27017/jct?authSource=admin

# Public origin of the site. Read by src/lib/page-nav-links.ts to decide which
# absolute navbar URLs count as same-origin; without it, a navbar link written
# as https://jct.ac.in/p/... can make the admin page list badge a live page as
# an orphan. NEXT_PUBLIC_*, so it is inlined at build time and must be present
# in the Docker build environment, not only at runtime.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Object storage — any S3-compatible server (on-prem Garage by default, see
# deploy/garage.toml.example). Optional as a whole: images and documents fall
# back to being served through /api/public/images/<key> if none of this is set.
# Partial configuration is refused at boot: set all four, or none.
# ─────────────────────────────────────────────────────────────────────────────

STORAGE_ENDPOINT=https://cdn.jct.ac.in
STORAGE_BUCKET=jct-assets
STORAGE_ACCESS_KEY_ID=GK...
STORAGE_SECRET_ACCESS_KEY=...

# Part of the SigV4 signature, so it must match the server's configured region
# EXACTLY (Garage's `s3_region` in garage.toml). A mismatch fails every call
# with SignatureDoesNotMatch, which reads like bad credentials and sends you
# looking in the wrong place.
STORAGE_REGION=garage

# Path-style addressing (https://host/bucket/key). Defaults to true; set false
# only on a server with the wildcard DNS virtual-host style needs.
STORAGE_FORCE_PATH_STYLE=true

# Optional. Where THIS PROCESS reaches the S3 API, when that is not the public
# address. STORAGE_ENDPOINT has to be public because the browser signs presigned
# PUTs against it — but on the on-prem box Garage is a container on the same
# host, so leaving it unset sends every server-side call (a backup makes one per
# object, thousands of them) out through public DNS to the WAN address, back in
# through the router, through nginx's TLS, and only then to loopback. That is
# why building a backup archive appears to "need the internet" on a machine that
# holds every byte locally, and why it stops working when the link does.
#
# Only the host differs: bucket, keys, region and SigV4 are unchanged, and
# STORAGE_REGION must still match the server's s3_region. Presigned URLs keep
# using STORAGE_ENDPOINT — a URL the browser cannot resolve is useless.
#
# `garage` is the compose service name, resolvable on the `jct` bridge network
# at runtime. Do NOT use 127.0.0.1: that is the app container's own loopback,
# not the host's. This is runtime-only, so `network: host` at build time (which
# cannot resolve `garage`) does not matter — nothing calls S3 during the build.
STORAGE_INTERNAL_ENDPOINT=http://garage:3900

# Public origin uploaded assets are served from. NEXT_PUBLIC_*, so it is
# inlined at BUILD time and must be present in the Docker build environment,
# not only at runtime — changing it needs a rebuild, not just a restart. It
# must be https: next.config.ts allowlists only https for /_next/image.
# Leave it unset and assets are proxied through /api/public/images/<key>
# instead, which works but copies every byte through Node.
#
# NOTE: this is NOT the same URL as STORAGE_ENDPOINT + bucket, and it must not
# include the bucket segment. Garage's S3 API refuses every unsigned request
# ("Forbidden: Garage does not support anonymous access yet"), so a browser
# cannot read https://cdn.jct.ac.in/jct-assets/images/x.webp at all. Public
# reads go to Garage's separate web endpoint, which nginx maps onto the same
# hostname at the root path — see deploy/nginx-jct.conf.example. The stored key
# is appended directly, giving https://cdn.jct.ac.in/images/x.webp.
NEXT_PUBLIC_STORAGE_PUBLIC_URL=https://cdn.jct.ac.in

# Where the admin backup route builds archives before they are downloaded
# (optional, defaults to a jct-backups folder under the OS temp dir). A full
# archive is currently several GB, so in Docker this should point at a bind-mounted
# host volume — otherwise it lands on the container's overlay filesystem and is
# discarded on every image pull. See docker-compose.prod.yaml.
BACKUP_DIR=/var/backups/jct

# Optional. When set, the backup download hands nginx an X-Accel-Redirect under
# this prefix instead of piping the archive through Node, so nginx serves it
# with sendfile(). Requires a matching `internal` location — see
# deploy/nginx-jct.conf.example. Leave unset and Node serves the file itself,
# which still supports resume and byte ranges, just with an extra copy.
BACKUP_ACCEL_PREFIX=/internal-backups

# Mongo connection pool size per instance (optional, default 10). Lower it on
# serverless, where many ephemeral instances each open a pool and can exhaust
# the Atlas connection cap; raise it for a single long-lived container.
MONGODB_MAX_POOL_SIZE=10

# ─────────────────────────────────────────────────────────────────────────────
# On-prem stack only — read by docker-compose.prod.yaml, not by this app
#
# Needed when MongoDB runs as a container from this repo's compose file rather
# than as a managed service. They seed the root user on FIRST START only: once
# /srv/jct/mongo has data, changing them here does nothing and the credentials
# must be changed with db.changeUserPassword() instead.
# ─────────────────────────────────────────────────────────────────────────────

# MONGO_ROOT_USER=jct
# MONGO_ROOT_PASSWORD=change-me

# ─────────────────────────────────────────────────────────────────────────────
# Consumed by dependencies, not by this repo's code
#
# These never appear in a `grep process.env src/`, because the library reads
# them itself. Grepping the source is therefore NOT a reliable way to discover
# required configuration — this block exists so the ones that matter are still
# written down somewhere.
# ─────────────────────────────────────────────────────────────────────────────

# Read by next-auth. It defaults to false outside development, and every
# /api/auth/* call then fails with UntrustedHost — i.e. nobody can log in.
# `trustHost: true` is also set in src/auth.ts so a missing value here can't
# take the admin panel down; this stays as documentation.
AUTH_TRUST_HOST=true
