# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/jct_admin

# NextAuth.js — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-32-char-secret-here
NEXTAUTH_URL=http://localhost:3000

# Cloudflare R2 (optional — images fallback to local /uploads if not set)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=jct-admin-images

# R2 public CDN URL (optional)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
