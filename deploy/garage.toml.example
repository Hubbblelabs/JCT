# Garage configuration for the JCT on-prem object store.
#
# Copy to deploy/garage.toml (which docker-compose.prod.yaml mounts read-only
# at /etc/garage.toml) and fill in the two secrets below. Garage replaces the
# Cloudflare R2 bucket; MinIO is not an option, its community Docker images
# were withdrawn in October 2025 and the repository is archived.
#
# ─────────────────────────────────────────────────────────────────────────────
# First-time setup, once the container is running
# ─────────────────────────────────────────────────────────────────────────────
#
#   alias garage='docker compose exec garage /garage'
#
# 1. Claim the single node into the cluster layout. `garage status` prints the
#    node id; capacity is what the node advertises, so size it to the volume.
#
#      garage status
#      garage layout assign -z jct -c 500G <node-id>
#      garage layout apply --version 1
#
# 2. Create the bucket and a key for the app.
#
#      garage bucket create jct-assets
#      garage key create jct-app
#      garage bucket allow --read --write --owner jct-assets --key jct-app
#
#    The printed key id and secret go into .env as STORAGE_ACCESS_KEY_ID and
#    STORAGE_SECRET_ACCESS_KEY. The secret is shown once.
#
# 3. Allow anonymous reads, so the public site can serve images directly
#    instead of proxying every byte through Node.
#
#      garage bucket website --allow jct-assets
#      garage bucket allow --read jct-assets --key <anonymous-or-public-key>
#
# 4. CORS. THIS IS NOT OPTIONAL and it is the step that gets forgotten.
#    Document uploads go presign -> browser PUT -> confirm, so the browser
#    talks to this server directly. Without a CORS rule allowing PUT from the
#    site's origin, every document upload fails in the browser and the server
#    logs nothing at all. There is no server-side fallback: proxy.ts truncates
#    any request body it matches at 10 MB, so routing large PDFs through the
#    app is not possible.
#
#      aws --endpoint-url https://s3.jct.ac.in s3api put-bucket-cors \
#        --bucket jct-assets \
#        --cors-configuration '{
#          "CORSRules": [{
#            "AllowedOrigins": ["https://jct.ac.in"],
#            "AllowedMethods": ["GET", "PUT", "HEAD"],
#            "AllowedHeaders": ["*"],
#            "ExposeHeaders": ["ETag"],
#            "MaxAgeSeconds": 3000
#          }]
#        }'
#
# 5. Verify before trusting it: upload a >10 MB PDF through an admin documents
#    editor. That single test exercises presign, CORS, path-style addressing,
#    the signing region and nginx's body-size limit at once.

# One node, so one copy. Raise this only alongside adding real nodes —
# replication_factor 3 on a single node makes the cluster permanently
# unhealthy rather than safer.
replication_factor = 1

metadata_dir = "/var/lib/garage/meta"
data_dir     = "/var/lib/garage/data"

# Both generated with: openssl rand -hex 32
# rpc_secret authenticates node-to-node traffic; admin_token guards the admin
# API. Neither is optional, and neither belongs in git.
rpc_secret   = "REPLACE_WITH_openssl_rand_hex_32"
rpc_bind_addr = "[::]:3901"
rpc_public_addr = "127.0.0.1:3901"

[s3_api]
api_bind_addr = "[::]:3900"

# The signing region is hashed into every SigV4 signature, so this string and
# the app's STORAGE_REGION must match EXACTLY. A mismatch fails every request
# with SignatureDoesNotMatch — an error that reads like bad credentials and
# sends you auditing keys that were fine all along.
s3_region = "garage"

# Path-style addressing (https://s3.jct.ac.in/jct-assets/images/x.webp) needs
# no wildcard DNS. Leave root_domain unset unless *.s3.jct.ac.in resolves; the
# app defaults STORAGE_FORCE_PATH_STYLE to true whenever STORAGE_ENDPOINT is
# set, which matches this.
# root_domain = ".s3.jct.ac.in"

[admin]
api_bind_addr = "127.0.0.1:3903"
admin_token   = "REPLACE_WITH_openssl_rand_hex_32"
