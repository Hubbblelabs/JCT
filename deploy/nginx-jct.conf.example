# Reverse-proxy settings required by the admin backup/restore routes.
#
# These are NOT optional if backups are used with images/documents included.
# The prod host's nginx config lives outside this repo (docker-compose.prod.yaml
# publishes the app on :3000 and nothing else), so this file is the reference —
# copy the relevant directives into the server block that fronts jct.
#
# Why each one matters:
#
#   client_max_body_size
#     POST /api/admin/site-config/restore takes the whole ZIP as its request
#     body. nginx defaults to 1 MB and answers 413 before the handler ever
#     runs. The current bucket is ~7.5 GB, so this must be unlimited (0) or set
#     well above the largest expected archive.
#
#   proxy_request_buffering off
#     Left on (the default), nginx spools the entire upload to its own disk
#     before forwarding a single byte. That doubles the disk cost of a restore
#     and delays the NDJSON progress stream until after the upload completes.
#
#   proxy_buffering off / X-Accel-Buffering
#     The restore response is an NDJSON progress stream, and the backup download
#     is a multi-gigabyte file. Buffering either through nginx's own disk adds a
#     full extra copy before the client sees anything. Both routes already send
#     `X-Accel-Buffering: no`; this is the belt-and-braces equivalent.
#
#   timeouts
#     A multi-gigabyte transfer runs for minutes. The 60s defaults will cut it.

location /api/admin/site-config/ {
    proxy_pass http://127.0.0.1:3000;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Restore: accept an arbitrarily large archive, and stream it through.
    client_max_body_size       0;
    proxy_request_buffering    off;

    # Backup download and restore progress: pass bytes through as they arrive.
    proxy_buffering            off;

    # Both directions run for minutes on a large archive.
    proxy_read_timeout         3600s;
    proxy_send_timeout         3600s;
    send_timeout               3600s;
}

# ── Optional: let nginx serve the finished backup archive itself ──────────────
#
# A backup is built to disk first (BACKUP_DIR) and only then downloaded, so the
# download is an ordinary static file. Without the block below, Node reads that
# file and pipes it through the proxy — which works, and supports resume, but
# copies every byte through the application process.
#
# Set BACKUP_ACCEL_PREFIX=/internal-backups on the app and add this location,
# and the download route instead answers with an `X-Accel-Redirect`. nginx then
# serves the file with sendfile(), handles Range requests natively, and Node
# leaves the data path entirely. On a multi-gigabyte archive this is the
# difference between one process copy per byte and none.
#
# `internal` is what makes this safe: the location cannot be requested directly
# from outside, only reached via the redirect the app issues after it has run
# `requireRole(req, "admin")`. Do NOT drop that keyword — the archive contains
# every site config value and every uploaded file.
#
# The alias must be the HOST path that docker-compose.prod.yaml bind-mounts to
# the container's BACKUP_DIR.

location /internal-backups/ {
    internal;
    alias /srv/jct/backups/;

    sendfile   on;
    tcp_nopush on;
    # The archive is already deflated; re-compressing it wastes CPU and defeats
    # sendfile().
    gzip       off;
}

# ── Object storage vhost (on-prem Garage) ────────────────────────────────────
#
# docker-compose.prod.yaml publishes Garage's S3 API on 127.0.0.1:3900 and
# nothing else; this block is what puts TLS in front of it.
#
# It carries BOTH kinds of traffic, which is why it needs the upload
# directives as well as the caching ones:
#
#   - The browser's presigned PUT when an admin uploads a document. That path
#     is not optional and has no server-side fallback — proxy.ts truncates any
#     request body it matches at 10 MB, so large PDFs can only reach storage
#     by going browser-to-Garage directly.
#   - Public GETs of every image and document on the site.
#
# TLS is mandatory, not a nicety: next.config.ts allowlists the asset host for
# /_next/image with `protocol: "https"` only. Served over plain HTTP, every
# optimised image fails with '"url" parameter is not allowed'.
#
# The app is then configured with:
#   STORAGE_ENDPOINT=https://s3.jct.ac.in
#   NEXT_PUBLIC_STORAGE_PUBLIC_URL=https://s3.jct.ac.in/jct-assets
#
# CORS must be configured here (nginx), not in Garage. Garage v2.0.0 does not
# support CORS via the S3 API. nginx add_header alone doesn't work for OPTIONS
# responses when Garage returns 4xx, so we intercept OPTIONS first.

server {
    listen 443 ssl http2;
    server_name cdn.jct.ac.in;

    # ssl_certificate / ssl_certificate_key — issue with certbot as usual.

    # Handle CORS preflight
    if ($request_method = 'OPTIONS') {
        add_header 'Access-Control-Allow-Origin' 'https://jct.ac.in' always;
        add_header 'Access-Control-Allow-Methods' 'GET, PUT, HEAD' always;
        add_header 'Access-Control-Allow-Headers' '*' always;
        add_header 'Access-Control-Expose-Headers' 'ETag' always;
        add_header 'Access-Control-Max-Age' '3000' always;
        add_header 'Content-Length' '0' always;
        return 204;
    }

    location / {
        proxy_pass http://127.0.0.1:3900;

        proxy_http_version 1.1;
        # Garage signs against the Host header it receives. Rewriting it breaks
        # every SigV4 signature, so pass the original through untouched.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Add CORS headers to all responses
        add_header 'Access-Control-Allow-Origin' 'https://jct.ac.in' always;
        add_header 'Access-Control-Allow-Methods' 'GET, PUT, HEAD' always;
        add_header 'Access-Control-Expose-Headers' 'ETag' always;

        # Presigned PUT of a prospectus PDF. The 1 MB default 413s the upload
        # before Garage ever sees it, and buffering spools the whole file to
        # nginx's disk first for no benefit.
        client_max_body_size    0;
        proxy_request_buffering off;
        proxy_buffering         off;

        proxy_read_timeout      3600s;
        proxy_send_timeout      3600s;
        send_timeout            3600s;
    }

    # Uploaded assets are immutable — the key contains a timestamp and a
    # replacement gets a new key, so nothing under these prefixes is ever
    # rewritten in place. Garage does not set Cache-Control itself, and
    # without one every image is re-fetched from origin on each page view.
    location ~ ^/[^/]+/(images|documents)/ {
        proxy_pass http://127.0.0.1:3900;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # No `always`: nginx then applies this to 2xx/3xx only, so a 404 for an
        # object that has not finished uploading is not cached for a month.
        add_header Cache-Control "public, max-age=2592000, immutable";

        client_max_body_size    0;
        proxy_request_buffering off;
        proxy_read_timeout      3600s;
    }
}
