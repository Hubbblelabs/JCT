# Garage production configuration for JCT on-prem object storage
# Copy this to deploy/garage.toml on the production server

# Single node, one replica (raise this only when adding real nodes)
replication_factor = 1

metadata_dir = "/var/lib/garage/meta"
data_dir     = "/var/lib/garage/data"

# Generate with: openssl rand -hex 32
# MUST match between all cluster nodes. Never change after first start.
rpc_secret   = "your-32-hex-random-string-here"
rpc_bind_addr = "[::]:3901"
rpc_public_addr = "127.0.0.1:3901"

[s3_api]
api_bind_addr = "[::]:3900"

# The signing region is hashed into every SigV4 signature and MUST match
# STORAGE_REGION in .env EXACTLY. A mismatch fails every request with
# SignatureDoesNotMatch — an error that reads like bad credentials and sends
# you auditing keys that were fine all along.
# Common values: "garage", "us-east-1", or your custom region name.
s3_region = "garage"

# Path-style addressing (https://s3.jct.ac.in/jct-assets/images/x.webp) needs
# no wildcard DNS. Virtual-host style needs *.s3.jct.ac.in to resolve.
# Leave root_domain unset for path-style (default, app sets STORAGE_FORCE_PATH_STYLE=true).
# root_domain = ".s3.jct.ac.in"

[admin]
api_bind_addr = "127.0.0.1:3903"
# Generate with: openssl rand -hex 32
# Never shared; only used by admin commands (garage CLI).
admin_token   = "your-32-hex-random-string-here"

# ─────────────────────────────────────────────────────────────────────────────
# Setup after first start (run these ONCE, on first boot only)
# ─────────────────────────────────────────────────────────────────────────────
#
# When the container is first running:
#
#   alias garage='docker compose exec garage /garage'
#
# 1. Claim the node into the cluster layout. `garage status` prints node id.
#    Capacity should match /var/lib/garage/data volume size.
#
#      garage status
#      garage layout assign -z jct -c 500G <node-id>
#      garage layout apply --version 1
#
# 2. Create bucket and API key for the app:
#
#      garage bucket create jct-assets
#      garage key create jct-app
#      garage bucket allow --read --write --owner jct-assets --key jct-app
#
#    Copy the printed key id and secret into .env as:
#      STORAGE_ACCESS_KEY_ID=...
#      STORAGE_SECRET_ACCESS_KEY=...
#    The secret is shown ONCE.
#
# 3. Enable public reads (so images can be served directly, not proxied):
#
#      garage bucket website --allow jct-assets
#      garage bucket allow --read jct-assets --key <anonymous-key>
#
# 4. CORS is configured in nginx, NOT here. Garage v2.0.0 does not support CORS
#    configuration via the S3 API. See deploy/nginx-jct.conf.example — nginx
#    intercepts OPTIONS requests and adds the CORS headers.
#
# 5. Verify before trusting: upload a >10 MB PDF through an admin documents
#    editor. That single test exercises presign, CORS, path-style addressing,
#    the signing region, and nginx's body-size limit at once.
#
# ─────────────────────────────────────────────────────────────────────────────
# Monitoring
# ─────────────────────────────────────────────────────────────────────────────
#
# Check cluster health:
#   garage status
#
# Monitor storage usage:
#   garage stats detailed
#
# List buckets and keys:
#   garage bucket list
#   garage key list
